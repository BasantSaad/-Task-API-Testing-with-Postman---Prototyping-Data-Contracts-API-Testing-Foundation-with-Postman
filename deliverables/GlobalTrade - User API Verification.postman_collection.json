{
  "info": {
    "_postman_id": "afbd50e0-82b3-4a23-83fa-671d33242e75",
    "name": "GlobalTrade - User API Verification",
    "description": "Verifies the GlobalTrade Corp User Management API contract (status codes, JSON wire format, Bearer auth) against the ReqRes mock service.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "60175608",
    "_collection_link": "https://go.postman.co/collection/60175608-afbd50e0-82b3-4a23-83fa-671d33242e75?source=collection_link"
  },
  "item": [
    {
      "name": "GET - Retrieve Users",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Verify that the retrieve users endpoint returns a 200 OK status', function () {\n    pm.response.to.have.status(200);\n});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "x-api-key",
            "value": "{{api_key}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/users?page=2&x-api-key={{api_key}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "users"
          ],
          "query": [
            {
              "key": "page",
              "value": "2"
            },
            {
              "key": "x-api-key",
              "value": "{{api_key}}"
            }
          ]
        }
      },
      "response": []
    },
    {
      "name": "POST - Create New User",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Verify that the user creation endpoint returns a 201 Created status', function () {\n    pm.response.to.have.status(201);\n});\n\npm.test('Verify that the user creation response body is valid JSON and parses into an object', function () {\n    const responseData = pm.response.json();\n    pm.expect(responseData).to.be.an('object');\n});\n\npm.test('Verify that the user creation response payload contains an id property', function () {\n    const responseData = pm.response.json();\n    pm.expect(responseData).to.have.property('id');\n});"
            ]
          }
        }
      ],
      "protocolProfileBehavior": {
        "disabledSystemHeaders": {}
      },
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "x-api-key",
            "value": "{{api_key}}"
          },
          {
            "key": "Authorization",
            "value": "{{bearer_token_0zbs}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"name\": \"Alex Mercer\",\n    \"job\": \"Operations Manager\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/api/users?x-api-key={{api_key}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "users"
          ],
          "query": [
            {
              "key": "x-api-key",
              "value": "{{api_key}}"
            }
          ]
        }
      },
      "response": []
    }
  ],
  "variable": [
    {
      "key": "bearer_token_0zbs",
      "secret": true
    }
  ]
